# Postgres connection URL, postgres:// or postgresql://. Used by the API, worker and migrations.
DATABASE_URL=
# 1Click partner JWT, sent as X-API-Key. Used by the API and worker.
ONECLICK_PARTNER_KEY=
# NEAR AI Cloud API key, starts with sk-. Used by the worker.
NEARAI_API_KEY=
# Encrypts 1Click session tokens: 32 random bytes, base64 encoded. Used by the API only (L31).
SESSION_ENCRYPTION_KEY=
# Encrypts agent keys: 32 random bytes, base64 encoded. Used by the worker only. Never give it to the API (L31).
AGENT_KEY_MASTER_KEY=
# One of: development, test, production.
NODE_ENV=
# One of: fatal, error, warn, info, debug, trace.
LOG_LEVEL=
# NEAR RPC URL for the sign-in key check. Optional; defaults to https://rpc.fastnear.com. Used by the API.
NEAR_RPC_URL=
# App identifier wallets sign for, such as veylo.app. Used by the API.
AUTH_RECIPIENT=
# Web app origin allowed by CORS, such as https://app.veylo.app, with no path. Used by the API.
WEB_ORIGIN=
# Session lifetime in hours, 1 to 720. Optional; defaults to 24. Used by the API.
SESSION_TTL_HOURS=
# Port the API listens on. Optional; defaults to 3000. Used by the API.
PORT=
# Proxy hops to trust for the client IP used by rate limiting. Optional; defaults to 0 (off).
# Verify against the real host at deploy time: too few limits all clients together, too many lets clients spoof their IP.
TRUST_PROXY_HOPS=
# Live-quote and signing-request limits, per route, per hour. Optional; default 60 per org, 30 per user. Used by the API.
TREASURY_LIMIT_ORG_PER_HOUR=
TREASURY_LIMIT_USER_PER_HOUR=
# Payout quote deadline in minutes (L34). Optional; default 15. Used by the API.
PAYOUT_QUOTE_DEADLINE_MINUTES=
# Amount change that flags a pay-run item, in percent. Optional; default 25. Used by the API.
REVIEW_AMOUNT_DEVIATION_PERCENT=
# 1Click's quote-signing key, ed25519:<base58>. Optional; defaults to the key pinned in S-C. Used by the API.
ONECLICK_QUOTE_PUBLIC_KEY=
# Public RPC endpoints for the evidence re-check in pnpm verify (section 11.5). No keys. Optional; the defaults are the
# documented public endpoints: archival-rpc.mainnet.fastnear.com, mainnet.base.org, arb1.arbitrum.io/rpc,
# bsc-dataseed.bnbchain.org and api.mainnet-beta.solana.com. Used by tools/verify.
EVIDENCE_NEAR_RPC_URL=
EVIDENCE_BASE_RPC_URL=
EVIDENCE_ARBITRUM_RPC_URL=
EVIDENCE_BSC_RPC_URL=
EVIDENCE_SOLANA_RPC_URL=
