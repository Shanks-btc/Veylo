{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "types": ["node"],
    "allowJs": false,
    "resolveJsonModule": true,
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["src", "bridge", "next-env.d.ts"],
  "exclude": ["node_modules", ".next", "out"]
}
