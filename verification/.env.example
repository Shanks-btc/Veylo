# Company treasury NEAR mainnet account ID (holds USDC).
TREASURY_ACCOUNT_ID=
# Treasury account private key.
TREASURY_SECRET_KEY=
# AI agent payer NEAR mainnet account ID (x402).
AGENT_ACCOUNT_ID=
# Agent account private key; must be a full-access key (x402 SignedDelegate).
AGENT_SECRET_KEY=
# x402 seller / API payee NEAR mainnet account ID; needs USDC storage registration only.
SELLER_ACCOUNT_ID=
# Contractor payout recipient address on Solana.
CONTRACTOR_SOLANA_ADDRESS=
# Dev-only Solana contractor private key, base58 (never for production).
CONTRACTOR_SOLANA_SECRET_KEY=
# Contractor payout recipient address on Base/Arbitrum.
CONTRACTOR_EVM_ADDRESS=
# Dev-only EVM contractor private key, 0x hex (never for production).
CONTRACTOR_EVM_SECRET_KEY=
# Contractor payout recipient address on Tron.
CONTRACTOR_TRON_ADDRESS=
# Dev-only Tron contractor private key, hex (never for production).
CONTRACTOR_TRON_SECRET_KEY=
# Gas sponsor NEAR mainnet account ID (T8).
RELAYER_ACCOUNT_ID=
# Relayer account private key (T8).
RELAYER_SECRET_KEY=
# 1Click API JWT from partners.near-intents.org, sent as X-API-Key (T2-T6).
ONECLICK_JWT=
# NEAR AI Cloud API key from cloud.near.ai, starts with sk- (T10).
NEARAI_API_KEY=
# Base URL of the chosen x402 facilitator (T7).
X402_FACILITATOR_URL=
# API key for the x402 facilitator's /verify and /settle endpoints (T7).
X402_FACILITATOR_API_KEY=
# End user NEAR mainnet account ID that signs delegate actions (T8).
USER_ACCOUNT_ID=
# End user account private key (T8).
USER_SECRET_KEY=
# NEAR mainnet account the T9 test contract deploys to.
ROLES_CONTRACT_ACCOUNT_ID=
# Roles contract account private key (T9).
ROLES_CONTRACT_SECRET_KEY=
# NEAR mainnet account that receives the restricted function-call key (T9).
ROLES_TEST_ACCOUNT_ID=
# Roles test account private key (T9).
ROLES_TEST_SECRET_KEY=
# Dev-only T5c recipient NEAR implicit account ID (never for production).
RECIPIENT_NEAR_ACCOUNT_ID=
# Dev-only T5c recipient private key (never for production).
RECIPIENT_NEAR_SECRET_KEY=
# Dev-only T7 agent payer NEAR testnet implicit account ID (never for production).
AGENT_TESTNET_ACCOUNT_ID=
# Dev-only T7 agent payer NEAR testnet full-access private key (never for production).
AGENT_TESTNET_SECRET_KEY=
# Dev-only T7 seller NEAR testnet implicit account ID (never for production).
SELLER_TESTNET_ACCOUNT_ID=
# Dev-only T7 seller NEAR testnet full-access private key (never for production).
SELLER_TESTNET_SECRET_KEY=
# Dev-only T7 facilitator relayer NEAR testnet implicit account ID (never for production).
FACILITATOR_RELAYER_TESTNET_ACCOUNT_ID=
# Dev-only T7 facilitator relayer NEAR testnet full-access private key (never for production).
FACILITATOR_RELAYER_TESTNET_SECRET_KEY=
# Dev-only T7 faucet-sponsored NEAR testnet account ID (never for production).
FUNDER_TESTNET_ACCOUNT_ID=
# Dev-only T7 funder testnet private key (never for production).
FUNDER_TESTNET_SECRET_KEY=
